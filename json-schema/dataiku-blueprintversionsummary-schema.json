{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/BlueprintVersionSummary",
  "title": "BlueprintVersionSummary",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "Version identifier"
    },
    "versionNumber": {
      "type": "integer",
      "description": "Version number"
    },
    "status": {
      "type": "string",
      "enum": [
        "DRAFT",
        "PUBLISHED",
        "ARCHIVED"
      ],
      "description": "Version status"
    },
    "createdOn": {
      "type": "integer",
      "format": "int64",
      "description": "Creation timestamp"
    }
  }
}