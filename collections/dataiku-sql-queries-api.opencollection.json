{
  "opencollection": "1.0.0",
  "info": {
    "name": "Dataiku API Node Administration Artifact Sign-Offs SQL Queries API",
    "version": "13.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "SQL Queries",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Dataiku Execute a SQL query",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{apinode-host}:{port}/admin/api/sql/queries",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Execute a SQL query on a DSS connection and retrieve the results."
        }
      ]
    }
  ],
  "bundled": true
}