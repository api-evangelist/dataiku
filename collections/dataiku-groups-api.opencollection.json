{
  "opencollection": "1.0.0",
  "info": {
    "name": "Dataiku API Node Administration Artifact Sign-Offs Groups API",
    "version": "13.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Groups",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Dataiku List groups",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{apinode-host}:{port}/admin/api/admin/groups"
          },
          "docs": "List all groups on the DSS instance."
        },
        {
          "info": {
            "name": "Dataiku Get group details",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{apinode-host}:{port}/admin/api/admin/groups/:groupName",
            "params": [
              {
                "name": "groupName",
                "value": "",
                "type": "path",
                "description": "Group name"
              }
            ]
          },
          "docs": "Get the details of a specific group."
        }
      ]
    }
  ],
  "bundled": true
}