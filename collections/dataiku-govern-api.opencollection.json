                "name": "blueprintId",
                "value": "",
                "type": "path",
                "description": "Unique blueprint identifier"
              }
            ]
          },
          "docs": "List all versions of a governance blueprint."
        },
        {
          "info": {
            "name": "Dataiku Create a blueprint version",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{govern-host}/public/api/blueprints/:blueprintId/versions",
            "params": [
              {
                "name": "blueprintId",
                "value": "",
                "type": "path",
                "description": "Unique blueprint identifier"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new version of a governance blueprint."
        },
        {
          "info": {
            "name": "Dataiku Get blueprint version details",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{govern-host}/public/api/blueprints/:blueprintId/versions/:versionId",
            "params": [
              {
                "name": "blueprintId",
                "value": "",
                "type": "path",
                "description": "Unique blueprint identifier"
              },
              {
                "name": "versionId",
                "value": "",
                "type": "path",
                "description": "Blueprint version identifier"
              }
            ]
          },
          "docs": "Get the full definition of a blueprint version."
        }
      ]
    },
