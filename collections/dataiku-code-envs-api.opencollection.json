{
  "opencollection": "1.0.0",
  "info": {
    "name": "Dataiku API Node Administration Artifact Sign-Offs Code Envs API",
    "version": "13.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Code Envs",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Dataiku List code environments",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{apinode-host}:{port}/admin/api/admin/code-envs"
          },
          "docs": "List all code environments on the DSS instance."
        },
        {
          "info": {
            "name": "Dataiku Get code environment details",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{apinode-host}:{port}/admin/api/admin/code-envs/:envLang/:envName",
            "params": [
              {
                "name": "envLang",
                "value": "",
                "type": "path",
                "description": "Code environment language (PYTHON or R)"
              },
              {
                "name": "envName",
                "value": "",
                "type": "path",
                "description": "Code environment name"
              }
            ]
          },
          "docs": "Get the definition of a code environment."
        }
      ]
    }
  ],
  "bundled": true
}