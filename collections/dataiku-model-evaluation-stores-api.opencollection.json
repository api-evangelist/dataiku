{
  "opencollection": "1.0.0",
  "info": {
    "name": "Dataiku API Node Administration Artifact Sign-Offs Model Evaluation Stores API",
    "version": "13.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Model Evaluation Stores",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Dataiku List model evaluation stores",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{apinode-host}:{port}/admin/api/projects/:projectKey/modelevaluationstores",
            "params": [
              {
                "name": "projectKey",
                "value": "",
                "type": "path",
                "description": "Unique project key identifier"
              }
            ]
          },
          "docs": "List all model evaluation stores in a project."
        }
      ]
    }
  ],
  "bundled": true
}